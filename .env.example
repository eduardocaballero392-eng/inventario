# =====================================================================
#  CONFIGURACIÓN - copia este archivo como ".env" y completa los datos.
#  En Vercel, crea estas mismas variables en:
#  Project Settings → Environment Variables
# =====================================================================

# --- Base de datos MySQL ---
# Opción A: una sola URL (la que te da el proveedor: TiDB Cloud, Aiven, Railway...)
# DATABASE_URL=mysql://usuario:contraseña@host:puerto/inventario

# Opción B: datos por separado (ej. WAMP/XAMPP local: usuario root sin contraseña)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=inventario

# true si el proveedor exige conexión segura (TiDB Cloud, Aiven, PlanetScale: SÍ)
DB_SSL=false

# --- Seguridad ---
# Cadena larga y aleatoria. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
JWT_EXPIRES=12h

# --- Negocio ---
# Zona horaria del negocio (Perú = -05:00)
TZ_OFFSET=-05:00

# Puerto del servidor local (no se usa en Vercel)
PORT=3000
