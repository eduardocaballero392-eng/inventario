{
  "name": "sistema-inventario-pos",
  "version": "1.0.0",
  "author": "Sistema de Inventario",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "build": "node scripts/copy-vendor.js",
    "postinstall": "node scripts/copy-vendor.js",
    "db:setup": "node server/db/setup.js",
    "db:setup:clean": "node server/db/setup.js --clean",
    "db:reset": "node server/db/setup.js --reset",
    "electron": "electron .",
    "electron:build": "electron-builder",
    "app": "electron .",
    "crear-app": "electron-builder"
  },
  "license": "UNLICENSED",
  "description": "Sistema de inventario y punto de venta para bodegas y minimarkets",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.6.1",
    "compression": "^1.8.2",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide": "^1.77.0",
    "motion": "^14.14.0",
    "mysql2": "^3.24.6",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.inventario.pos",
    "productName": "Sistema de Inventario",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "portable"
      ],
      "icon": "public/img/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "electron/**/*",
      "server/**/*",
      "public/**/*",
      "node_modules/**/*",
      "package.json"
    ]
  },
  "private": true,
  "engines": {
    "node": ">=18"
  }
}
